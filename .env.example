# Environment configuration for local development
# Copy this file to .env and modify the values as needed

# Database Configuration
DATABASE_URL=postgresql+asyncpg://your_username:your_password@localhost:5432/your_database_name

# Alternative individual settings (used if DATABASE_URL is not set)
DB_HOST=localhost
DB_PORT=5432
DB_USER=your_username
DB_PASSWORD=your_password
DB_NAME=your_database_name

# Server Configuration
HOST=0.0.0.0
PORT=8000

# LLM Configuration for natural-language-to-SQL generation.
# Leave LLM_PROVIDER unset to use rule-based SQL generation (no LLM calls at all).
# LLM_PROVIDER=anthropic | openai | openrouter | ollama
LLM_PROVIDER=
LLM_MODEL=
# Generic key checked first for all providers; falls back to the provider-specific
# var below if unset (so existing ANTHROPIC_API_KEY/OPENAI_API_KEY setups still work).
LLM_API_KEY=
# LLM_BASE_URL=          # override, e.g. a self-hosted OpenAI-compatible endpoint
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=512

# Provider-specific examples:
#
# Anthropic:
#   LLM_PROVIDER=anthropic
#   LLM_MODEL=claude-sonnet-5
#   ANTHROPIC_API_KEY=sk-ant-...
#
# OpenAI:
#   LLM_PROVIDER=openai
#   LLM_MODEL=gpt-4o-mini
#   OPENAI_API_KEY=sk-...
#
# OpenRouter (routes to many hosted models via one OpenAI-compatible API):
#   LLM_PROVIDER=openrouter
#   LLM_MODEL=deepseek/deepseek-chat
#   OPENROUTER_API_KEY=sk-or-...
#
# Ollama (local models, no API key):
#   LLM_PROVIDER=ollama
#   LLM_MODEL=llama3.1
#   LLM_BASE_URL=http://localhost:11434

# Write-tool safety: execute_unsafe_sql/create_table/insert_data/update_data/delete_data
# are all disabled unless this is explicitly enabled. delete_data/update_data additionally
# require either a where_condition or confirm_full_table=True even when this is on.
ALLOW_WRITE_OPERATIONS=false

# Example configurations for different databases:

# Local PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/myapp

# Local MySQL:
# DATABASE_URL=mysql+pymysql://root:password@localhost:3306/myapp

# SQLite (for testing):
# DATABASE_URL=sqlite+aiosqlite:///./local_test.db