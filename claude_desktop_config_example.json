{
  "mcpServers": {
    "mcp-db-server": {
      "command": "docker",
      "args": [
        "run",
        "--rm",
        "-i",
        "-p", "3000:3000",
        "-e", "DATABASE_URL=sqlite+aiosqlite:////data/claude_test.db",
        "-e", "LLM_PROVIDER=anthropic",
        "-e", "LLM_MODEL=claude-sonnet-5",
        "-e", "ANTHROPIC_API_KEY",
        "-e", "ALLOW_WRITE_OPERATIONS=false",
        "souhardyak/mcp-db-server"
      ],
      "env": {
        "ANTHROPIC_API_KEY": "sk-ant-..."
      }
    }
  }
}